{{ 'section-collection-carousel.css' | asset_url | stylesheet_tag }}

<div class="carousel-section page-width">
  <div class="carousel-section__header">
    {% if section.settings.heading != blank %}
      <h2 class="carousel-section__heading">{{ section.settings.heading }}</h2>
    {% endif %}
    <div class="carousel-section__nav">
      <button type="button" class="carousel-arrow carousel-arrow--prev" aria-label="Previous">&#8249;</button>
      <button type="button" class="carousel-arrow carousel-arrow--next" aria-label="Next">&#8250;</button>
    </div>
  </div>

  <ul class="carousel-track" role="list">
    {% for block in section.blocks %}
      {% assign collection = block.settings.collection %}
      <li class="carousel-card" {{ block.shopify_attributes }}>
        <a href="{{ collection.url | default: '#' }}" class="carousel-card__link">
          {% if collection.featured_image %}
            {{ collection.featured_image | image_url: width: 800 | image_tag:
              loading: 'lazy',
              sizes: '(min-width: 750px) 300px, 70vw',
              widths: '300,450,600,800',
              class: 'carousel-card__image'
            }}
          {% else %}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'carousel-card__image placeholder' }}
          {% endif %}
          <span class="carousel-card__overlay"></span>
          <span class="carousel-card__title">{{ collection.title | default: block.settings.fallback_title }}</span>
        </a>
      </li>
    {% endfor %}
  </ul>
</div>

<script>
(function() {
  document.querySelectorAll('.carousel-section').forEach(function(section) {
    var track = section.querySelector('.carousel-track');
    var prev = section.querySelector('.carousel-arrow--prev');
    var next = section.querySelector('.carousel-arrow--next');
    var scrollAmount = function() {
      var card = track.querySelector('.carousel-card');
      return card ? card.offsetWidth + 16 : 300;
    };
    prev.addEventListener('click', function() {
      track.scrollBy({ left: -scrollAmount(), behavior: 'smooth' });
    });
    next.addEventListener('click', function() {
      track.scrollBy({ left: scrollAmount(), behavior: 'smooth' });
    });
  });
})();
</script>

{% schema %}
{
  "name": "Collection Carousel",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our Garden Collections" },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "collection_card",
      "name": "Collection Card",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "fallback_title", "label": "Fallback title (if no collection selected)", "default": "Collection" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection Carousel",
      "category": "Custom Collections",
      "blocks": [
        { "type": "collection_card" },
        { "type": "collection_card" },
        { "type": "collection_card" },
        { "type": "collection_card" }
      ]
    }
  ]
}
{% endschema %}
