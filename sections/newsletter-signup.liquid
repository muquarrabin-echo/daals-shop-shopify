{{ 'section-newsletter-signup.css' | asset_url | stylesheet_tag }}

<style>
  #shopify-section-{{ section.id }} {
    --ns-bg: {{ section.settings.background_color }};
    --ns-heading-color: {{ section.settings.heading_color }};
    --ns-text-color: {{ section.settings.text_color }};
    --ns-legal-color: {{ section.settings.legal_color }};
    --ns-padding-top: {{ section.settings.padding_top }}px;
    --ns-separator-color: {{ section.settings.separator_color }};
    --ns-padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: var(--ns-bg);
  }
</style>

<div
  class="ns-section"
  id="ns-{{ section.id }}"
  style="
    padding-top: var(--ns-padding-top);
    padding-bottom: var(--ns-padding-bottom);
  "
>
  <div class="page-width">
    <div class="ns-inner">
      
      {%- if section.settings.heading != blank -%}
        <h2 class="ns-heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="ns-text">
          {{ section.settings.text }}
        </div>
      {%- endif -%}

      {%- if section.settings.legal_text != blank -%}
        <div class="ns-legal">
          {{ section.settings.legal_text }}
        </div>
      {%- endif -%}

      {% form 'customer', class: 'ns-form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        
        <div class="ns-form-row">
          <input
            type="email"
            name="contact[email]"
            class="ns-input"
            value="{{ form.email }}"
            placeholder="{{ section.settings.placeholder }}"
            aria-label="{{ section.settings.placeholder }}"
            required
            autocomplete="email"
          >

          <button type="submit" class="ns-button">
            {{ section.settings.button_label }}
          </button>
        </div>

        {%- if form.errors -%}
          <div class="ns-message ns-message--error">
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        {%- if form.posted_successfully? -%}
          <div class="ns-message ns-message--success">
            {{ section.settings.success_message }}
          </div>
        {%- endif -%}
      {% endform %}

    </div>
  </div>

  {%- if section.settings.show_separator -%}
    <div class="ns-separator"></div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Newsletter Signup",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Better decisions, delivered."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Sign up for carefully selected releases, room guidance, and exclusive previews shaped by our design team.</p>"
    },
    {
      "type": "richtext",
      "id": "legal_text",
      "label": "Legal text",
      "default": "<p>By subscribing, you agree to our Privacy Policy and consent to receive communications from daals.</p>"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Email placeholder",
      "default": "Enter your email address"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "SUBSCRIBE"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Thanks for subscribing!"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#4a4a4a"
    },
    {
      "type": "color",
      "id": "legal_color",
      "label": "Legal text color",
      "default": "#6b6b6b"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "checkbox",
      "id": "show_separator",
      "label": "Show bottom separator line",
      "default": true
    },
    {
        "type": "color",
        "id": "separator_color",
        "label": "Separator line color",
        "default": "#000000"
    }
  ],
  "presets": [
    {
      "name": "Newsletter Signup",
      "category": "Custom Sections"
    }
  ]
}
{% endschema %}