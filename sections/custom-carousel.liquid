{{ 'section-custom-carousel.css' | asset_url | stylesheet_tag }}
{{ 'section-custom-carousel.js' | asset_url | script_tag }}

<style>
  #shopify-section-{{ section.id }} {
    --carousel-bg: {{ section.settings.background_color }};
    --carousel-heading-color: {{ section.settings.heading_color }};
    --carousel-padding-top: {{ section.settings.padding_top }}px;
    --carousel-padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: var(--carousel-bg);
  }
</style>

<div
  class="carousel-section page-width"
  id="carousel-{{ section.id }}"
  data-carousel-type="{{ section.settings.carousel_type }}"
  style="
    padding-top: var(--carousel-padding-top);
    padding-bottom: var(--carousel-padding-bottom);
  "
>
  <div class="carousel-section__header">
    {% if section.settings.heading != blank %}
      <h2 class="carousel-section__heading">{{ section.settings.heading }}</h2>
    {% endif %}
    <div class="carousel-section__nav">
      <button type="button" class="carousel-arrow carousel-arrow--prev" aria-label="Previous" disabled>&#8249;</button>
      <button type="button" class="carousel-arrow carousel-arrow--next" aria-label="Next">&#8250;</button>
    </div>
  </div>

  <ul class="carousel-track" role="list">
    {% for block in section.blocks %}
      {% case block.type %}

        {% when 'collection_card' %}
          {% if section.settings.carousel_type == 'collections' %}
            {% assign collection = block.settings.collection %}
            <li class="carousel-card carousel-card--collection" {{ block.shopify_attributes }}>
              <a href="{{ collection.url | default: '#' }}" class="carousel-card__link">
                {% if collection.featured_image %}
                  {{
                    collection.featured_image
                    | image_url: width: 800
                    | image_tag:
                      loading: 'lazy',
                      sizes: '(min-width: 750px) 300px, 70vw',
                      widths: '300,450,600,800',
                      class: 'carousel-card__image'
                  }}
                {% else %}
                  {{ 'lifestyle-1' | placeholder_svg_tag: 'carousel-card__image placeholder' }}
                {% endif %}
                <span class="carousel-card__overlay"></span>
                <span class="carousel-card__title">
                  {{ collection.title | default: block.settings.fallback_title }}
                </span>
              </a>
            </li>
          {% endif %}

        {% when 'product_card' %}
          {% if section.settings.carousel_type == 'products' %}
            {% assign product = block.settings.product %}
            <li class="carousel-card carousel-card--product" {{ block.shopify_attributes }}>
              <a href="{{ product.url | default: '#' }}" class="carousel-card__link">
                {% if product.featured_media %}
                  {{
                    product.featured_media
                    | image_url: width: 800
                    | image_tag:
                      loading: 'lazy',
                      sizes: '(min-width: 750px) 280px, 70vw',
                      widths: '300,450,600,800',
                      class: 'carousel-card__image'
                  }}
                {% else %}
                  {{ 'product-1' | placeholder_svg_tag: 'carousel-card__image placeholder' }}
                {% endif %}

                <div class="carousel-card__info">
                  <span class="carousel-card__title">
                    {{ product.title | default: block.settings.fallback_title }}
                  </span>
                  {% if product.price %}
                    <span class="carousel-card__price">
                      {{ product.price | money }}
                    </span>
                  {% endif %}
                </div>
              </a>
            </li>
          {% endif %}

      {% endcase %}
    {% endfor %}
  </ul>
</div>

{% schema %}
{
  "name": "Custom Carousel",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "select",
      "id": "carousel_type",
      "label": "Carousel type",
      "options": [
        { "value": "collections", "label": "Collections" },
        { "value": "products", "label": "Products" }
      ],
      "default": "collections"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Finish the Room"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#f8f5f0"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "collection_card",
      "name": "Collection Card",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "fallback_title",
          "label": "Fallback title",
          "default": "Collection"
        }
      ]
    },
    {
      "type": "product_card",
      "name": "Product Card",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "text",
          "id": "fallback_title",
          "label": "Fallback title",
          "default": "Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection / Product Carousel",
      "category": "Custom Sections",
      "blocks": [
        { "type": "collection_card" },
        { "type": "collection_card" },
        { "type": "collection_card" },
        { "type": "collection_card" }
      ]
    }
  ]
}
{% endschema %}