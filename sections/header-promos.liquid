<div class="header-promos">
  {% content_for 'blocks' %}
</div>

{% stylesheet %}
  .header-promos {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 48px;
    background-color: #2c3e4d;
    padding: 10px 20px;
    width: 100%;
  }

  @media screen and (max-width: 749px) {
    .header-promos {
      gap: 20px;
      padding: 8px 16px;
      overflow-x: auto;
      flex-wrap: nowrap;
      justify-content: flex-start;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "header-promos",
  "blocks": [
    {
      "type": "_header-promo-item"
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#2c3e4d"
    }
  ]
}
{% endschema %}