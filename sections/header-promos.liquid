<style>
  #shopify-section-{{ section.id }} {
    --hp-bg: {{ section.settings.background_color }};
  }
</style>

{{ 'section-header-promos.css' | asset_url | stylesheet_tag }}

<div class="header-promos" data-header-promos>
  {% content_for 'blocks' %}
</div>

{% javascript %}
  (function () {
    function initCarousel(container) {
      var items = Array.prototype.slice.call(container.children);
      if (items.length <= 1) return;

      var current = 0;
      var intervalId = null;

      function showSlide(index) {
        items.forEach(function (item, i) {
          item.classList.toggle('is-active', i === index);
        });
      }

      function nextSlide() {
        current = (current + 1) % items.length;
        showSlide(current);
      }

      function start() {
        showSlide(current);
        intervalId = setInterval(nextSlide, 6000);
      }

      function stop() {
        if (intervalId) clearInterval(intervalId);
        intervalId = null;
      }

      var mq = window.matchMedia('(max-width: 749px)');

      function handleChange(e) {
        if (e.matches) {
          start();
        } else {
          stop();
          items.forEach(function (item) {
            item.classList.remove('is-active');
          });
        }
      }

      mq.addEventListener('change', handleChange);
      handleChange(mq);
    }

    function initAll() {
      document.querySelectorAll('[data-header-promos]').forEach(initCarousel);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAll);
    } else {
      initAll();
    }
  })();
{% endjavascript %}

{% schema %}
{
  "name": "header-promos",
  "blocks": [
    {
      "type": "_header-promo-item"
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#2c3e4d"
    }
  ]
}
{% endschema %}