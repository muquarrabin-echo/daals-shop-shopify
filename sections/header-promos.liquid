<div class="header-promos" data-header-promos>
  {% content_for 'blocks' %}
</div>

{% stylesheet %}
  .header-promos {
    display: flex;
    justify-content: space-around;
    align-items: center;
    flex-wrap: wrap;
    background-color: #354E5A;
    padding: 10px 20px;
  }

  @media screen and (max-width: 749px) {
    .header-promos {
      position: relative;
      display: block;
      padding: 8px 0;
      height: 40px;
      overflow: hidden;
    }

    .header-promos > * {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      display: flex;
      justify-content: center;
      align-items: center;
      opacity: 0;
      pointer-events: none;
      transition: opacity 1.2s ease-in-out;
    }

    .header-promos > *.is-active {
      opacity: 1;
      pointer-events: auto;
    }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    function initCarousel(container) {
      var items = Array.prototype.slice.call(container.children);
      if (items.length <= 1) return;

      var current = 0;
      var intervalId = null;

      function showSlide(index) {
        items.forEach(function (item, i) {
          item.classList.toggle('is-active', i === index);
        });
      }

      function nextSlide() {
        current = (current + 1) % items.length;
        showSlide(current);
      }

      function start() {
        showSlide(current);
        intervalId = setInterval(nextSlide, 6000);
      }

      function stop() {
        if (intervalId) clearInterval(intervalId);
        intervalId = null;
      }

      var mq = window.matchMedia('(max-width: 749px)');

      function handleChange(e) {
        if (e.matches) {
          start();
        } else {
          stop();
          items.forEach(function (item) {
            item.classList.remove('is-active');
          });
        }
      }

      mq.addEventListener('change', handleChange);
      handleChange(mq);
    }

    function initAll() {
      document.querySelectorAll('[data-header-promos]').forEach(initCarousel);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAll);
    } else {
      initAll();
    }
  })();
{% endjavascript %}

{% schema %}
{
  "name": "header-promos",
  "blocks": [
    {
      "type": "_header-promo-item"
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#2c3e4d"
    }
  ]
}
{% endschema %}