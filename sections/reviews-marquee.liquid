{{ 'section-reviews-marquee.css' | asset_url | stylesheet_tag }}
{{ 'section-reviews-marquee.js' | asset_url | script_tag }}

<style>
  #shopify-section-{{ section.id }} {
    {%- if section.settings.background_image != blank %}
    background-image: url({{ section.settings.background_image | image_url: width: 2400 }});
    background-size: cover;
    background-position: center;
    {%- else %}
    background-color: {{ section.settings.fallback_background_color }};
    {%- endif %}
  }

  #rvm-{{ section.id }} .rvm-marquee__track {
    animation-duration: {{ section.settings.marquee_speed }}s;
  }
</style>

<div class="rvm-section" id="rvm-{{ section.id }}">
  <div class="rvm-overlay"></div>

  <div class="rvm-top page-width">
    <div class="rvm-heading-block">
      {%- if section.settings.heading != blank -%}
        <h2 class="rvm-heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      <p class="rvm-rating-line">
        {%- if section.settings.rating_prefix != blank -%}
          <span class="rvm-rating-prefix">{{ section.settings.rating_prefix }}</span>
        {%- endif -%}
        {%- if section.settings.rating_word != blank -%}
          <span class="rvm-rating-word">{{ section.settings.rating_word }}</span>
        {%- endif -%}
        {%- if section.settings.rating_suffix != blank -%}
          <span class="rvm-rating-suffix">
            {{ section.settings.rating_suffix }}
          </span>
        {%- endif -%}
      </p>
    </div>

    <div class="rvm-nav">
      <button type="button" class="rvm-arrow rvm-arrow--prev" aria-label="Previous" disabled>&#8249;</button>
      <button type="button" class="rvm-arrow rvm-arrow--next" aria-label="Next">&#8250;</button>
    </div>
  </div>

  <div class="rvm-track-wrap">
    <ul class="rvm-track" role="list">
      {%- for block in section.blocks -%}
        {%- if block.type == 'review' -%}
          <li class="rvm-card" {{ block.shopify_attributes }}>
            <div class="rvm-card__image-wrap">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 400
                  | image_tag:
                    loading: 'lazy',
                    sizes: '150px',
                    widths: '150,250,400',
                    class: 'rvm-card__image'
                }}
              {%- else -%}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'rvm-card__image placeholder' }}
              {%- endif -%}
            </div>

            <div class="rvm-card__content">
              <div class="rvm-card__stars" aria-label="{{ block.settings.rating }} out of 5 stars">
                {%- assign stars = block.settings.rating | at_most: 5 | at_least: 0 -%}
                {%- for i in (1..5) -%}
                  {%- if i <= stars -%}
                    <span class="rvm-star rvm-star--filled">&#9733;</span>
                  {%- else -%}
                    <span class="rvm-star">&#9733;</span>
                  {%- endif -%}
                {%- endfor -%}
              </div>

              {%- if block.settings.title != blank -%}
                <p class="rvm-card__title">{{ block.settings.title }}</p>
              {%- endif -%}

              {%- if block.settings.quote != blank -%}
                <p class="rvm-card__quote">{{ block.settings.quote }}</p>
              {%- endif -%}

              {%- if block.settings.name != blank -%}
                <p class="rvm-card__name">{{ block.settings.name }}</p>
              {%- endif -%}
            </div>
          </li>
        {%- endif -%}
      {%- else -%}
        {%- for i in (1..3) -%}
          <li class="rvm-card rvm-card--placeholder">
            <div class="rvm-card__image-wrap">
              {{ 'lifestyle-1' | placeholder_svg_tag: 'rvm-card__image placeholder' }}
            </div>
            <div class="rvm-card__content">
              <div class="rvm-card__stars" aria-label="5 out of 5 stars">
                {%- for i in (1..5) -%}
                  <span class="rvm-star rvm-star--filled">&#9733;</span>
                {%- endfor -%}
              </div>
              <p class="rvm-card__title">Great experience!</p>
              <p class="rvm-card__quote">Add a review to this block to replace this placeholder text.</p>
              <p class="rvm-card__name">Customer name</p>
            </div>
          </li>
        {%- endfor -%}
      {%- endfor -%}
    </ul>
  </div>

  {%- liquid
    assign has_logos = false
    for block in section.blocks
      if block.type == 'logo'
        assign has_logos = true
      endif
    endfor
  -%}

  {%- if has_logos or section.settings.marquee_label != blank -%}
    <div class="rvm-marquee-wrap">
      {%- if section.settings.marquee_label != blank -%}
        <p class="rvm-marquee-label page-width">{{ section.settings.marquee_label }}</p>
      {%- endif -%}

      <div class="rvm-marquee">
        <div class="rvm-marquee__track">
          {%- for block in section.blocks -%}
            {%- if block.type == 'logo' -%}
              <div class="rvm-marquee__item" {{ block.shopify_attributes }}>
                {%- if block.settings.image != blank -%}
                  {{ block.settings.image | image_url: width: 300 | image_tag: loading: 'lazy', class: 'rvm-marquee__logo' }}
                {%- elsif block.settings.text != blank -%}
                  <span class="rvm-marquee__text">{{ block.settings.text }}</span>
                {%- endif -%}
              </div>
            {%- endif -%}
          {%- endfor -%}
          {%- comment -%} duplicate for seamless loop {%- endcomment -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'logo' -%}
              <div class="rvm-marquee__item" aria-hidden="true">
                {%- if block.settings.image != blank -%}
                  {{ block.settings.image | image_url: width: 300 | image_tag: loading: 'lazy', class: 'rvm-marquee__logo' }}
                {%- elsif block.settings.text != blank -%}
                  <span class="rvm-marquee__text">{{ block.settings.text }}</span>
                {%- endif -%}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Reviews Marquee",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "color",
      "id": "fallback_background_color",
      "label": "Fallback background color",
      "default": "#2b2118"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Don't just take our word"
    },
    {
      "type": "text",
      "id": "rating_prefix",
      "label": "Rating prefix text",
      "default": "Rated"
    },
    {
      "type": "text",
      "id": "rating_word",
      "label": "Rating word",
      "default": "Excellent"
    },
    {
      "type": "text",
      "id": "rating_suffix",
      "label": "Rating suffix text",
      "default": "on Trustpilot"
    },
    {
      "type": "text",
      "id": "marquee_label",
      "label": "Marquee label",
      "default": "As Seen in:"
    },
    {
      "type": "range",
      "id": "marquee_speed",
      "label": "Marquee speed (seconds)",
      "min": 10,
      "max": 60,
      "step": 2,
      "default": 30
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "range", "id": "rating", "label": "Star rating", "min": 0, "max": 5, "step": 1, "default": 5 },
        { "type": "text", "id": "title", "label": "Review title", "default": "Amazing quality!" },
        { "type": "textarea", "id": "quote", "label": "Review quote" },
        { "type": "text", "id": "name", "label": "Customer name", "default": "Customer" }
      ]
    },
    {
      "type": "logo",
      "name": "Marquee logo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Logo image" },
        { "type": "text", "id": "text", "label": "Text fallback", "info": "Used if no image is set." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reviews Marquee",
      "category": "Custom Sections",
      "blocks": [
        { "type": "review" },
        { "type": "review" },
        { "type": "review" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" }
      ]
    }
  ]
}
{% endschema %}
