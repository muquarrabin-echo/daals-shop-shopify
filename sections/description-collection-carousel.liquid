{{ 'section-description-collection-carousel.css' | asset_url | stylesheet_tag }}

<style>
  #shopify-section-{{ section.id }} {
    --dcc-bg: {{ section.settings.background_color }};
    --dcc-heading-color: {{ section.settings.heading_color }};
    --dcc-text-color: {{ section.settings.text_color }};
    --dcc-arrow-color: {{ section.settings.arrow_color }};
    --dcc-arrow-border: {{ section.settings.arrow_border_color }};
    --dcc-arrow-hover-bg: {{ section.settings.arrow_hover_bg }};
    --dcc-card-title-color: {{ section.settings.card_title_color }};
    --dcc-border-color: {{ section.settings.border_color }};
    --dcc-padding-top: {{ section.settings.padding_top }}px;
    --dcc-padding-bottom: {{ section.settings.padding_bottom }}px;

    background-color: var(--dcc-bg);
    {%- if section.settings.show_bottom_border %}
    border-bottom: 1px solid var(--dcc-border-color);
    {%- endif %}
  }

  #dcc-{{ section.id }}.dcc-section {
    padding-top: var(--dcc-padding-top);
    padding-bottom: var(--dcc-padding-bottom);
  }
</style>

<div class="dcc-section page-width" id="dcc-{{ section.id }}">
  <div class="dcc-left">
    {%- if section.settings.heading != blank -%}
      <h2 class="dcc-heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.description != blank -%}
      <div class="dcc-description">{{ section.settings.description }}</div>
    {%- endif -%}

    <div class="dcc-nav">
      <button type="button" class="dcc-arrow dcc-arrow--prev" aria-label="Previous">&#8249;</button>
      <button type="button" class="dcc-arrow dcc-arrow--next" aria-label="Next">&#8250;</button>
    </div>
  </div>

  <div class="dcc-right">
    <ul class="dcc-track" role="list">
      {%- for block in section.blocks -%}
        {%- if block.type == 'collection_card' -%}
          {%- liquid
            assign col = block.settings.collection
            assign custom_label = block.settings.label
            assign custom_image = block.settings.image
          -%}
          <li class="dcc-card" {{ block.shopify_attributes }}>
            <a href="{{ col.url | default: '#' }}" class="dcc-card__link">
              {%- if custom_image != blank -%}
                {{
                  custom_image
                  | image_url: width: 800
                  | image_tag:
                    loading: 'lazy',
                    sizes: '(min-width: 750px) 320px, 70vw',
                    widths: '300,450,600,800',
                    class: 'dcc-card__image'
                }}
              {%- elsif col != blank and col.featured_image != blank -%}
                {{
                  col.featured_image
                  | image_url: width: 800
                  | image_tag:
                    loading: 'lazy',
                    sizes: '(min-width: 750px) 320px, 70vw',
                    widths: '300,450,600,800',
                    class: 'dcc-card__image'
                }}
              {%- else -%}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'dcc-card__image placeholder' }}
              {%- endif -%}
              <span class="dcc-card__overlay"></span>
              <span class="dcc-card__title">
                {{ custom_label | default: col.title | default: block.settings.fallback_title }}
              </span>
            </a>
          </li>
        {%- endif -%}
      {%- else -%}
        {%- for i in (1..4) -%}
          <li class="dcc-card dcc-card--placeholder">
            {{ 'lifestyle-1' | placeholder_svg_tag: 'dcc-card__image placeholder' }}
            <span class="dcc-card__overlay"></span>
            <span class="dcc-card__title">Collection</span>
          </li>
        {%- endfor -%}
      {%- endfor -%}
    </ul>
  </div>
</div>

<script>
  (function () {
    var root = document.getElementById('dcc-{{ section.id }}');
    if (!root) return;

    var track = root.querySelector('.dcc-track');
    var prev = root.querySelector('.dcc-arrow--prev');
    var next = root.querySelector('.dcc-arrow--next');

    var scrollAmount = function () {
      var card = track.querySelector('.dcc-card');
      return card ? card.offsetWidth + 16 : 300;
    };

    if (prev) {
      prev.addEventListener('click', function () {
        track.scrollBy({ left: -scrollAmount(), behavior: 'smooth' });
      });
    }
    if (next) {
      next.addEventListener('click', function () {
        track.scrollBy({ left: scrollAmount(), behavior: 'smooth' });
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Description Carousel",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Designed for living"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>A home is more than its structure. These are the finishing layers, the textiles, the outdoor moments, the adaptable pieces that make daily life feel considered and complete.</p>"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Description color",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "arrow_color",
      "label": "Arrow icon color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "arrow_border_color",
      "label": "Arrow border color",
      "default": "rgba(0,0,0,0.15)"
    },
    {
      "type": "color",
      "id": "arrow_hover_bg",
      "label": "Arrow hover background",
      "default": "rgba(0,0,0,0.04)"
    },
    {
      "type": "color",
      "id": "card_title_color",
      "label": "Card title color",
      "default": "#ffffff"
    },
    {
      "type": "checkbox",
      "id": "show_bottom_border",
      "label": "Show bottom border",
      "default": true
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Bottom border color",
      "default": "#e5e5e5"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "collection_card",
      "name": "Collection card",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom image",
          "info": "Optional. Overrides the collection's featured image."
        },
        {
          "type": "text",
          "id": "label",
          "label": "Custom label",
          "info": "Defaults to the collection title if left blank."
        },
        {
          "type": "text",
          "id": "fallback_title",
          "label": "Fallback title (if no collection selected)",
          "default": "Collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Description collection carousel",
      "category": "Custom Collections",
      "blocks": [
        { "type": "collection_card" },
        { "type": "collection_card" },
        { "type": "collection_card" },
        { "type": "collection_card" }
      ]
    }
  ]
}
{% endschema %}