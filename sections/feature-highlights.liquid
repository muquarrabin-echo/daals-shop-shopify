{{ 'section-feature-highlights.css' | asset_url | stylesheet_tag }}

<style>
  #shopify-section-{{ section.id }} {
    --fh-bg: {{ section.settings.background_color }};
    --fh-heading-color: {{ section.settings.heading_color }};
    --fh-text-color: {{ section.settings.text_color }};
    --fh-icon-bg: {{ section.settings.icon_background }};
    --fh-padding-top: {{ section.settings.padding_top }}px;
    --fh-padding-bottom: {{ section.settings.padding_bottom }}px;
  }
</style>

<div
  class="fh-section"
  id="fh-{{ section.id }}"
  style="
    background-color: var(--fh-bg);
    padding-top: var(--fh-padding-top);
    padding-bottom: var(--fh-padding-bottom);
  "
>
  <div class="page-width">
    <div
      class="fh-grid"
      style="
        --fh-columns: {{ section.settings.columns_desktop }};
        --fh-gap: {{ section.settings.column_gap }}px;
      "
    >
      {%- for block in section.blocks -%}
        <div class="fh-item" {{ block.shopify_attributes }}>
          {%- if block.settings.heading != blank -%}
            <h3 class="fh-heading">{{ block.settings.heading }}</h3>
          {%- endif -%}

          <div class="fh-icon-wrap">
            {%- if block.settings.svg != blank -%}
              <span class="fh-icon">
                {{ block.settings.svg }}
              </span>
            {%- else -%}
              {{ 'image' | placeholder_svg_tag: 'fh-icon fh-icon--placeholder' }}
            {%- endif -%}
          </div>

          {%- if block.settings.text != blank -%}
            <div class="fh-text">{{ block.settings.text }}</div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Feature Highlights",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Gap between items",
      "min": 16,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#4a4a4a"
    },
    {
      "type": "color",
      "id": "icon_background",
      "label": "Icon background",
      "default": "#f5f0eb"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "textarea",
          "id": "svg",
          "label": "SVG Code",
          "info": "Paste your full SVG code here (recommended viewBox size: 24×24)"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Feature heading"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Add a short description here."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Feature Highlights",
      "category": "Custom Sections",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "heading": "Delivered by daals",
            "text": "Free Standard Delivery on orders over £99"
          }
        },
        {
          "type": "feature",
          "settings": {
            "heading": "Flexible payment options",
            "text": "Pay in 3 or 4 interest-free instalments with Klarna or Clearpay"
          }
        },
        {
          "type": "feature",
          "settings": {
            "heading": "New Arrivals",
            "text": "New styles added regularly. Check our latest exclusive designs"
          }
        }
      ]
    }
  ]
}
{% endschema %}