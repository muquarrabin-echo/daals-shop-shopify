{{ 'section-featured-collection.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign heading = section.settings.heading
  assign left_image = section.settings.featured_image
  assign left_product = section.settings.featured_product
  assign left_label = section.settings.featured_label
  assign left_sublabel = section.settings.featured_sublabel
-%}

<section
  class="feature-section"
  id="feature-section-{{ section.id }}"
>
  <div class="page-width">

    {%- if heading != blank -%}
      <h2 class="feature-heading">{{ heading }}</h2>
    {%- endif -%}

    <div class="feature-section-grid">

      {%- comment -%} LEFT: sticky featured product/image {%- endcomment -%}
      <div class="feature-left">
        <div class="feature-sticky">
          <a
            href="{% if left_product != blank %}{{ left_product.url }}{% else %}{{ section.settings.featured_link }}{% endif %}"
            class="featured-product-card"
          >
            {%- if left_image != blank -%}
              {{
                left_image
                | image_url: width: 1200
                | image_tag:
                  loading: 'lazy',
                  sizes: '(min-width: 990px) 45vw, 100vw',
                  widths: '400,600,800,1000,1200',
                  class: 'featured-product-image'
              }}
            {%- elsif left_product != blank and left_product.featured_media != blank -%}
              {{
                left_product.featured_media
                | image_url: width: 1200
                | image_tag:
                  loading: 'lazy',
                  sizes: '(min-width: 990px) 45vw, 100vw',
                  widths: '400,600,800,1000,1200',
                  class: 'featured-product-image'
              }}
            {%- else -%}
              <div class="featured-product-image feature-placeholder">
                {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
              </div>
            {%- endif -%}

            <div class="featured-product-overlay">
              {%- if left_label != blank -%}
                <p class="featured-product-label">{{ left_label }}</p>
              {%- endif -%}
              {%- if left_sublabel != blank -%}
                <p class="featured-product-sublabel">{{ left_sublabel }}</p>
              {%- elsif left_product != blank -%}
                <p class="featured-product-sublabel">{{ left_product.title }}</p>
              {%- endif -%}
            </div>
          </a>
        </div>
      </div>

      {%- comment -%} RIGHT: scrollable collection grid {%- endcomment -%}
      <div class="feature-right">
        <div class="feature-scroll">
          <div class="feature-collection-grid">
            {%- for block in section.blocks -%}
              {%- if block.type == 'collection' -%}
                {%- liquid
                  assign col = block.settings.collection
                  assign custom_label = block.settings.label
                  assign custom_image = block.settings.image
                -%}
                <a
                  href="{{ col.url | default: '#' }}"
                  class="feature-tile"
                  {{ block.shopify_attributes }}
                >
                  {%- if custom_image != blank -%}
                    {{
                      custom_image
                      | image_url: width: 800
                      | image_tag:
                        loading: 'lazy',
                        sizes: '(min-width: 990px) 22vw, 50vw',
                        widths: '300,500,700,800',
                        class: 'feature-tile-image'
                    }}
                  {%- elsif col != blank and col.featured_image != blank -%}
                    {{
                      col.featured_image
                      | image_url: width: 800
                      | image_tag:
                        loading: 'lazy',
                        sizes: '(min-width: 990px) 22vw, 50vw',
                        widths: '300,500,700,800',
                        class: 'feature-tile-image'
                    }}
                  {%- else -%}
                    <div class="feature-tile-image feature-placeholder">
                      {{ 'collection-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
                    </div>
                  {%- endif -%}

                  <span class="feature-tile-label">
                    {{ custom_label | default: col.title | default: 'Collection' }}
                  </span>
                </a>
              {%- endif -%}
            {%- else -%}
              {%- for i in (1..4) -%}
                <div class="feature-tile feature-placeholder-tile">
                  <div class="feature-tile-image feature-placeholder">
                    {{ 'collection-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
                  </div>
                  <span class="feature-tile-label">Collection</span>
                </div>
              {%- endfor -%}
            {%- endfor -%}
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  (function () {
    var root = document.getElementById('feature-section-{{ section.id }}');
    if (!root) return;

    var image = root.querySelector('.featured-product-image');
    var scrollBox = root.querySelector('.feature-scroll');
    if (!image || !scrollBox) return;

    function syncHeight() {
      if (window.matchMedia('(max-width: 749px)').matches) {
        scrollBox.style.maxHeight = '';
        return;
      }
      var height = image.getBoundingClientRect().height;
      if (height > 0) {
        scrollBox.style.maxHeight = height + 'px';
      }
    }

    if (image.complete) {
      syncHeight();
    } else {
      image.addEventListener('load', syncHeight, { once: true });
    }

    window.addEventListener('load', syncHeight);
    window.addEventListener('resize', syncHeight);

    if (window.ResizeObserver) {
      new ResizeObserver(syncHeight).observe(image);
    }
  })();
</script>

{% schema %}
{
  "name": "Featured Collection",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured Collection"
    },
    {
      "type": "header",
      "content": "Left column — featured product"
    },
    {
      "type": "product",
      "id": "featured_product",
      "label": "Featured product",
      "info": "Used for the link and, if no image is chosen below, the product image."
    },
    {
      "type": "image_picker",
      "id": "featured_image",
      "label": "Featured image",
      "info": "Optional. Overrides the product image."
    },
    {
      "type": "url",
      "id": "featured_link",
      "label": "Featured link",
      "info": "Used only if no product is selected."
    },
    {
      "type": "text",
      "id": "featured_label",
      "label": "Overlay label",
      "default": "Featured Product"
    },
    {
      "type": "text",
      "id": "featured_sublabel",
      "label": "Overlay sublabel",
      "info": "Defaults to the product title if left blank."
    },
    {
      "type": "header",
      "content": "Right column — collection grid"
    },
    {
      "type": "range",
      "id": "grid_columns",
      "label": "Columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 2
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection tile",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom image",
          "info": "Optional. Overrides the collection's featured image."
        },
        {
          "type": "text",
          "id": "label",
          "label": "Custom label",
          "info": "Defaults to the collection title if left blank."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured collection",
        "category": "Custom Collections",
      "blocks": [
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" }
      ]
    }
  ]
}
{% endschema %}
