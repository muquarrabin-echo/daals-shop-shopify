{{ 'section-image-with-text-split.css' | asset_url | stylesheet_tag }}

<style>
  #shopify-section-{{ section.id }} {
    --iwt-bg: {{ section.settings.background_color }};
    --iwt-heading-color: {{ section.settings.heading_color }};
    --iwt-text-color: {{ section.settings.text_color }};
    --iwt-padding-top: {{ section.settings.padding_top }}px;
    --iwt-padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: var(--iwt-bg);
  }
</style>

<div
  class="iwt-section"
  id="iwt-{{ section.id }}"
  style="
    padding-top: var(--iwt-padding-top);
    padding-bottom: var(--iwt-padding-bottom);
  "
>
  <div class="page-width">
    <div class="iwt-grid{% if section.settings.image_position == 'right' %} iwt-grid--reverse{% endif %}">
      
      {%- comment -%} Image column {%- endcomment -%}
      <div class="iwt-media">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1600
            | image_tag:
              loading: 'lazy',
              widths: '400,600,800,1000,1200,1600',
              sizes: '(min-width: 990px) 50vw, 100vw',
              class: 'iwt-image',
              alt: section.settings.heading | escape
          }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'iwt-image iwt-image--placeholder' }}
        {%- endif -%}
      </div>

      {%- comment -%} Text column {%- endcomment -%}
      <div class="iwt-content">
        {%- if section.settings.heading != blank -%}
          <h2 class="iwt-heading">{{ section.settings.heading }}</h2>
        {%- endif -%}

        {%- if section.settings.text != blank -%}
          <div class="iwt-text">
            {{ section.settings.text }}
          </div>
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          <a
            href="{{ section.settings.button_link }}"
            class="iwt-button"
            {% if section.settings.button_link == blank %}aria-disabled="true"{% endif %}
          >
            {{ section.settings.button_label }}
          </a>
        {%- endif -%}
      </div>

    </div>
  </div>
</div>

{% schema %}
{
  "name": "Image with Text Split",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position (desktop)",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Art of Choosing Well."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>At daals, we select and design furniture with intention. From concept and material selection to final finish and delivery, every piece is shaped by balance, function, and lasting appeal. Crafted globally and managed end to end, our collections are created to work together, helping you build a home that feels considered, not complicated.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "See How We Work"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#f5f0eb"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#4a4a4a"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Image with Text Split",
      "category": "Custom Sections"
    }
  ]
}
{% endschema %}