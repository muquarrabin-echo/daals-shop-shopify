<div class="header-promo-item">
  <a class="header-promo-link" href="{{ block.settings.header_promo_link }}">
    {% if block.settings.header_promo_icon %}
      <img
        class="header-promo-icon"
        src="{{ block.settings.header_promo_icon | image_url: width: 60 }}"
        alt="{{ block.settings.header_promo_text }}"
        width="20"
        height="20"
        loading="lazy"
      >
    {% endif %}

    <p class="header-promo-text">
      <span>{{ block.settings.header_promo_text }}</span>
    </p>
  </a>
</div>

{% stylesheet %}
  .header-promo-item {
    display: flex;
    align-items: center;
  }

  .header-promo-link {
    display: flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    color: inherit;
  }

  .header-promo-icon {
    height: 20px;
    width: auto;
    object-fit: contain;
    flex-shrink: 0;
  }

  .header-promo-text {
    margin: 0;
    font-size: 13px;
    line-height: 1;
    color: #ffffff;
    white-space: nowrap;
  }
{% endstylesheet %}

{% schema %}
{
    "name": "Header Promo Item",
    "settings": [
        {
            "type": "text",
            "id": "header_promo_text",
            "label": "Header Promo Text"
        },
        {
            "type": "url",
            "id": "header_promo_link",
            "label": "Header Promo Link"
        },
        {
            "type": "image_picker",
            "id": "header_promo_icon",
            "label": "Header Promo Icon"
        }
    ],
    "presets": [
        {
            "name": "Header Promo Item"
        }
    ]
}
{% endschema %}