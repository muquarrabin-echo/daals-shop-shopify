<div class="predictive-search-wrapper" 
data-money-format="{{ shop.money_format | escape }}"
data-currency="{{ cart.currency.symbol | default: shop.currency }}"
data-placeholder="{{ 'image' | placeholder_svg_tag | escape }}">
  <div class="pill-search">
    <svg
      class="pill-search__icon"
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
    >
      <circle cx="11" cy="11" r="8"></circle>
      <path d="m21 21-4.35-4.35"></path>
    </svg>
    <input
      type="search"
      class="pill-search__input"
      placeholder="What are you looking for?"
      id="predictive-search-input"
      autocomplete="off"
      role="combobox"
      aria-expanded="false"
      aria-controls="predictive-search-results"
    >
  </div>

  <div class="predictive-search-results" id="predictive-search-results">
    <div class="psr-left">
      <div class="psr-section" id="psr-suggestions"></div>
      <div class="psr-section" id="psr-collections"></div>
      <div class="psr-section" id="psr-pages"></div>
    </div>

    <div class="psr-right">
      <div class="psr-products-header">Products</div>
      <div class="psr-products-grid" id="psr-products"></div>
      <a href="{{ routes.search_url }}" class="psr-view-all" id="psr-view-all">View all products →</a>
    </div>
  </div>
</div>

{% stylesheet %}
  .predictive-search-wrapper {
    position: relative;
    max-width: 480px;
    z-index: 50;
  }

  /* ===== PILL INPUT ===== */
  .pill-search {
    display: flex;
    align-items: center;
    background: #f5f5f5;
    border-radius: 9999px;
    padding: 11px 18px;
    transition: all 0.2s ease;
    border: 1px solid transparent;
  }

  .pill-search:focus-within {
    background: #fff;
    border-color: #ddd;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
  }

  .pill-search__icon {
    flex-shrink: 0;
    color: #666;
    margin-right: 12px;
  }

  .pill-search__input {
    flex: 1;
    border: none;
    background: transparent !important;
    font-size: 15px;
    outline: none;
    width: 100%;
  }

  .pill-search__input::-webkit-search-cancel-button {
    -webkit-appearance: none;
  }

  /* ===== DROPDOWN ===== */
  .predictive-search-results {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    width: 720px;
    max-width: 95vw;
    background: #fff;
    border-radius: 12px;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.12);
    display: none; /* hidden by default */
    grid-template-columns: 240px 1fr;
    overflow: hidden;
    z-index: 100;
    max-height: 520px;
  }

  .predictive-search-results.is-open {
    display: grid;
  }

  .psr-left {
    background: #fafafa;
    border-right: 1px solid #eee;
    padding: 20px 0;
    overflow-y: auto;
  }

  .psr-section {
    padding: 0 20px 16px;
  }

  .psr-section:empty {
    display: none; /* hide empty sections completely */
  }

  .psr-section + .psr-section {
    border-top: 1px solid #eee;
    padding-top: 16px;
  }

  .psr-section h4 {
    font-size: 12px;
    font-weight: 600;
    color: #888;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin: 0 0 10px;
  }

  .psr-section a {
    display: block;
    padding: 6px 0;
    color: #222;
    text-decoration: none;
    font-size: 14px;
  }

  .psr-section a:hover {
    color: #000;
    text-decoration: underline;
  }

  /* Right side */
  .psr-right {
    padding: 20px;
    display: flex;
    flex-direction: column;
  }

  .psr-products-header {
    font-size: 13px;
    font-weight: 600;
    color: #888;
    margin-bottom: 14px;
  }

  .psr-products-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    flex: 1;
    overflow-y: auto;
    min-height: 80px;
  }

  .psr-product {
    display: flex;
    gap: 12px;
    text-decoration: none;
    color: inherit;
  }

  .psr-product img {
    width: 70px;
    height: 70px;
    object-fit: cover;
    border-radius: 6px;
    background: #f5f5f5;
    flex-shrink: 0;
  }

  .psr-product-info {
    flex: 1;
    min-width: 0;
  }

  .psr-product-title {
    font-size: 13px;
    line-height: 1.35;
    margin-bottom: 4px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .psr-product-price {
    font-size: 13px;
    font-weight: 600;
  }

  .psr-view-all {
    display: block;
    text-align: center;
    margin-top: 16px;
    padding-top: 14px;
    border-top: 1px solid #eee;
    font-size: 14px;
    color: #222;
    text-decoration: none;
    font-weight: 500;
  }

  .psr-view-all:hover {
    text-decoration: underline;
  }

  .psr-empty {
    padding: 30px 10px;
    text-align: center;
    color: #999;
    font-size: 14px;
    grid-column: 1 / -1;
  }

  .psr-loading {
    padding: 40px;
    text-align: center;
    color: #999;
    font-size: 14px;
    grid-column: 1 / -1;
  }
  .psr-product svg {
    width: 70px;
    height: 70px;
    border-radius: 6px;
    flex-shrink: 0;
    display: block;
    background-color: #f4f4f4;
  }
{% endstylesheet %}

{% javascript %}
  class PredictiveSearch {
    constructor() {
      this.input = document.getElementById('predictive-search-input');
      this.results = document.getElementById('predictive-search-results');
      this.suggestionsEl = document.getElementById('psr-suggestions');
      this.collectionsEl = document.getElementById('psr-collections');
      this.pagesEl = document.getElementById('psr-pages');
      this.productsEl = document.getElementById('psr-products');
      this.viewAll = document.getElementById('psr-view-all');

      if (!this.input || !this.results) return;

      this.debounceTimer = null;

      this.input.addEventListener('input', () => this.onInput());
      this.input.addEventListener('focus', () => {
        if (this.input.value.trim().length > 0) {
          this.open();
        }
      });

      // Close when clicking outside
      document.addEventListener('click', (e) => {
        if (!e.target.closest('.predictive-search-wrapper')) {
          this.close();
        }
      });

      // Close on Escape
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') this.close();
      });
    }

    onInput() {
      clearTimeout(this.debounceTimer);
      const query = this.input.value.trim();

      if (query.length < 1) {
        this.close();
        return;
      }

      this.debounceTimer = setTimeout(() => this.fetchResults(query), 280);
    }

    async fetchResults(query) {
      // Show loading state
      this.productsEl.innerHTML = `<div class="psr-loading">Searching…</div>`;
      this.open();

      // Safer URL construction
      const root =
        window.Shopify && window.Shopify.routes && window.Shopify.routes.root ? window.Shopify.routes.root : '/';

      const url = `${root}search/suggest.json?q=${encodeURIComponent(
        query
      )}&resources[type]=product,collection,page,article,query&resources[limit]=8&resources[limit_scope]=each&resources[options][unavailable_products]=last`;

      try {
        const res = await fetch(url);

        if (!res.ok) {
          throw new Error(`HTTP ${res.status}`);
        }

        const data = await res.json();

        this.render(data.resources?.results || {}, query);
      } catch (err) {
        this.productsEl.innerHTML = `<div class="psr-empty">Something went wrong. Try again.</div>`;
      }
    }

    render(results, query) {
      // ===== Left column =====
      // Query suggestions
      if (results.queries && results.queries.length) {
        this.suggestionsEl.innerHTML = `
          <h4>Popular suggestions</h4>
          ${results.queries
            .map(
              (q) => `
            <a href="${q.url}">${q.styled_text || q.text}</a>
          `
            )
            .join('')}
        `;
      } else {
        this.suggestionsEl.innerHTML = '';
      }

      // Collections
      if (results.collections && results.collections.length) {
        this.collectionsEl.innerHTML = `
          <h4>Collections</h4>
          ${results.collections
            .map(
              (c) => `
            <a href="${c.url}">${c.title}</a>
          `
            )
            .join('')}
        `;
      } else {
        this.collectionsEl.innerHTML = '';
      }

      // Pages + Articles
      const pagesAndArticles = [...(results.pages || []), ...(results.articles || [])];

      if (pagesAndArticles.length) {
        this.pagesEl.innerHTML = `
          <h4>Blog & Pages</h4>
          ${pagesAndArticles
            .map(
              (p) => `
            <a href="${p.url}">${p.title}</a>
          `
            )
            .join('')}
        `;
      } else {
        this.pagesEl.innerHTML = '';
      }

     // ===== Right column - Products =====
    if (results.products && results.products.length) {
        const placeholder = document.querySelector('.predictive-search-wrapper')?.dataset.placeholder || '';
        this.productsEl.innerHTML = results.products.map(p => {
            const img = p.featured_image?.url || p.image || null;
            const price = this.formatMoney(p.price);

            return `
            <a href="${p.url}" class="psr-product">
                ${img 
                ? `<img src="${img}" alt="${p.title}" loading="lazy" width="70" height="70">`
                : placeholder
                }
                <div class="psr-product-info">
                <div class="psr-product-title">${p.title}</div>
                <div class="psr-product-price">${price}</div>
                </div>
            </a>
            `;
        }).join('');
        
    } else {
        this.productsEl.innerHTML = `<div class="psr-empty">No products found</div>`;
    }

      // View all link
      this.viewAll.href = `${window.Shopify?.routes?.root || '/'}search?q=${encodeURIComponent(query)}`;
      this.viewAll.textContent = `View all results →`;

      this.open();
    }

    formatMoney(cents) {
        if (typeof cents === 'undefined' || cents === null) return '';

        const wrapper = document.querySelector('.predictive-search-wrapper');
        const moneyFormat = wrapper?.dataset.moneyFormat || '${{amount}}';
        const currencySymbol = wrapper?.dataset.currency || '';

        // Prefer Shopify's native formatter
        if (typeof Shopify !== 'undefined' && typeof Shopify.formatMoney === 'function') {
            return Shopify.formatMoney(cents, moneyFormat);
        }

        // Fallback with currency symbol
        const amount = (Number(cents) / 100).toFixed(2);
        return currencySymbol + amount;
    }

    open() {
      this.results.classList.add('is-open');
      this.input.setAttribute('aria-expanded', 'true');
    }

    close() {
      this.results.classList.remove('is-open');
      this.input.setAttribute('aria-expanded', 'false');
    }
  }

  // Support both normal pages and section reloads
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => new PredictiveSearch());
  } else {
    new PredictiveSearch();
  }
{% endjavascript %}
