{%- doc -%}
  Predictive search pill + full-screen-on-mobile dropdown.

  ID-collision safe snippet for Horizon header.
  
  @param {string} [id_suffix] - Unique suffix so aria-controls/aria-owns
    don't collide when this snippet is rendered more than once on a page.
  @param {string} [class] - Additional classes for the wrapper.
{%- enddoc -%}

{% liquid
  assign uid = id_suffix | default: 'default'
  assign results_id = 'predictive-search-results-' | append: uid
%}

<div
  class="predictive-search-wrapper{% if class != blank %} {{ class | strip }}{% endif %}"
  data-money-format="{{ shop.money_format | escape }}"
  data-currency="{{ cart.currency.symbol | default: shop.currency }}"
  data-placeholder="{{ 'image' | placeholder_svg_tag | escape }}"
>

  <div class="pill-search">
    <button type="button" class="psr-back-btn" aria-label="Close search">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
        stroke-linecap="round" stroke-linejoin="round">
        <path d="M19 12H5"></path>
        <path d="M12 19l-7-7 7-7"></path>
      </svg>
    </button>

    <svg class="pill-search__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
      stroke-width="2">
      <circle cx="11" cy="11" r="8"></circle>
      <path d="m21 21-4.35-4.35"></path>
    </svg>
    
    <input type="search" class="pill-search__input" placeholder="What are you looking for?"
      autocomplete="off" role="combobox" aria-expanded="false" aria-controls="{{ results_id }}" aria-owns="{{ results_id }}">
    
    <button type="button" class="psr-clear-btn" aria-label="Clear search" hidden>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
        stroke-linecap="round" stroke-linejoin="round">
        <path d="M18 6 6 18"></path>
        <path d="m6 6 12 12"></path>
      </svg>
    </button>
  </div>

  <div class="predictive-search-results" id="{{ results_id }}">
    <div class="psr-left">
      <div class="psr-section psr-suggestions"></div>
      <div class="psr-section psr-collections"></div>
      <div class="psr-section psr-pages"></div>
    </div>

    <div class="psr-right">
      <div class="psr-products-header">Products</div>
      <div class="psr-products-grid"></div>
      <a href="{{ routes.search_url }}" class="psr-view-all">View all results →</a>
    </div>
  </div>
</div>

{% stylesheet %}
.predictive-search-wrapper {
  position: relative;
  max-width: 480px;
  z-index: 50;
}

/* ===== BACK BUTTON ===== */
.psr-back-btn {
  display: none;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px;
  flex-shrink: 0;
  border: none;
  background: transparent;
  color: #333;
  cursor: pointer;
  padding: 0;
}

/* ===== CLEAR (X) BUTTON INSIDE PILL ===== */
.psr-clear-btn {
  display: none;
  align-items: center;
  justify-content: center;
  width: 28px;
  height: 28px;
  flex-shrink: 0;
  border: none;
  background: transparent;
  color: #888;
  cursor: pointer;
  padding: 0;
  margin-left: 8px;
}

.psr-clear-btn:not([hidden]) {
  display: flex;
}

/* ===== PILL INPUT DEFAULT (NON-TRANSPARENT HEADER) ===== */
.pill-search {
  position: relative;
  display: flex;
  align-items: center;
  background: #f5f5f5;
  border-radius: 9999px;
  padding: 11px 18px;
  transition: all 0.25s ease;
  border: 1px solid transparent;
}

.pill-search__icon {
  flex-shrink: 0;
  color: #666;
  margin-right: 12px;
}

.pill-search__input {
  flex: 1;
  border: none;
  background: transparent !important;
  font-size: 15px;
  outline: none;
  width: 100%;
}

.pill-search__input::-webkit-search-cancel-button {
  -webkit-appearance: none;
}

/* ===== TRANSPARENT HEADER OVERRIDES ===== */
.header-wrapper--transparent .pill-search,
.header--transparent .pill-search,
.header[transparent] .pill-search,
header-component[transparent] .pill-search,
.shopify-section-header-sticky:not(.scrolled-past-header) .pill-search {
  background: rgba(255, 255, 255, 0.18) !important;
  border-color: rgba(255, 255, 255, 0.35) !important;
  box-shadow: none !important;
}

.header-wrapper--transparent .pill-search__icon,
.header--transparent .pill-search__icon,
.header[transparent] .pill-search__icon,
header-component[transparent] .pill-search__icon,
.shopify-section-header-sticky:not(.scrolled-past-header) .pill-search__icon {
  color: #ffffff !important;
}

.header-wrapper--transparent .pill-search__input,
.header--transparent .pill-search__input,
.header[transparent] .pill-search__input,
header-component[transparent] .pill-search__input,
.shopify-section-header-sticky:not(.scrolled-past-header) .pill-search__input {
  color: #ffffff !important;
}

.header-wrapper--transparent .pill-search__input::placeholder,
.header--transparent .pill-search__input::placeholder,
.header[transparent] .pill-search__input::placeholder,
header-component[transparent] .pill-search__input::placeholder,
.shopify-section-header-sticky:not(.scrolled-past-header) .pill-search__input::placeholder {
  color: rgba(255, 255, 255, 0.85) !important;
}

/* ===== ACTIVE OPEN STATE (WHEN DRAWER IS OPEN) ===== */
.predictive-search-wrapper:has(.predictive-search-results.is-open) .pill-search {
  background: #ffffff !important;
  border-color: #dddddd !important;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08) !important;
}

.predictive-search-wrapper:has(.predictive-search-results.is-open) .pill-search__icon {
  color: #666666 !important;
}

.predictive-search-wrapper:has(.predictive-search-results.is-open) .pill-search__input {
  color: #111111 !important;
}

.predictive-search-wrapper:has(.predictive-search-results.is-open) .pill-search__input::placeholder {
  color: #999999 !important;
  opacity: 1;
}

/* Force header background to solid white when search is actively open */
.header[transparent]:has(.predictive-search-results.is-open),
header-component[transparent]:has(.predictive-search-results.is-open),
.header-wrapper--transparent:has(.predictive-search-results.is-open) {
  --header-bg-color: var(--color-background, #ffffff);
  background-color: var(--color-background, #ffffff) !important;
}

/* ===== DROPDOWN (desktop) ===== */
.predictive-search-results {
  position: absolute;
  top: calc(100% + 8px);
  left: 0;
  width: 720px;
  max-width: 95vw;
  background: #fff;
  border-radius: 12px;
  box-shadow: 0 12px 40px rgba(0, 0, 0, 0.12);
  display: none;
  grid-template-columns: 240px 1fr;
  overflow: hidden;
  z-index: 100;
  max-height: 520px;
}

.predictive-search-results.is-open {
  display: grid;
}

/* Trending mode → single column */
.predictive-search-results.is-trending {
  grid-template-columns: 1fr;
}

.predictive-search-results.is-trending .psr-left {
  display: none;
}

.psr-left {
  background: #fafafa;
  border-right: 1px solid #eee;
  padding: 20px 0;
  overflow-y: auto;
}

.psr-section {
  padding: 0 20px 16px;
}

.psr-section:empty {
  display: none;
}

.psr-section + .psr-section {
  border-top: 1px solid #eee;
  padding-top: 16px;
}

.psr-section h4 {
  font-size: 12px;
  font-weight: 600;
  color: #888;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  margin: 0 0 10px;
}

.psr-section a {
  display: block;
  padding: 6px 0;
  color: #222;
  text-decoration: none;
  font-size: 14px;
}

.psr-section a:hover {
  color: #000;
  text-decoration: underline;
}

.psr-right {
  padding: 20px;
  display: flex;
  flex-direction: column;
}

.psr-products-header {
  font-size: 13px;
  font-weight: 600;
  color: #888;
  margin-bottom: 14px;
}

.psr-products-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
  flex: 1;
  overflow-y: auto;
  min-height: 80px;
}

.psr-product {
  display: flex;
  gap: 12px;
  text-decoration: none;
  color: inherit;
}

.psr-product img,
.psr-product svg {
  width: 70px;
  height: 70px;
  object-fit: cover;
  border-radius: 6px;
  background: #f4f4f4;
  flex-shrink: 0;
  display: block;
}

.psr-product-info {
  flex: 1;
  min-width: 0;
}

.psr-product-title {
  font-size: 13px;
  line-height: 1.35;
  margin-bottom: 4px;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.psr-product-price {
  font-size: 13px;
  font-weight: 600;
}

.psr-view-all {
  display: block;
  text-align: center;
  margin-top: 16px;
  padding-top: 14px;
  border-top: 1px solid #eee;
  font-size: 14px;
  color: #222;
  text-decoration: none;
  font-weight: 500;
}

.psr-view-all:hover {
  text-decoration: underline;
}

.psr-empty,
.psr-loading {
  padding: 40px 10px;
  text-align: center;
  color: #999;
  font-size: 14px;
  grid-column: 1 / -1;
}

/* =====================================================================
   MOBILE: Full-screen Takeover Drawer Layout
   ===================================================================== */
@media screen and (max-width: 749px) {
  /* HIDE ANNOUNCEMENT BAR & HEADER PROMOS WHEN DRAWER IS OPEN */
  body:has(.predictive-search-results.is-open) .announcement-bar,
  body:has(.predictive-search-results.is-open) .header-promos {
    display: none !important;
  }

  .predictive-search-wrapper {
    max-width: 100%;
    width: 100%;
  }

  /* Default state when drawer is closed */
  .predictive-search-wrapper--drawer {
    position: fixed;
    top: var(--header-height, 56px);
    left: 0;
    right: 0;
    width: 100%;
    margin: 0;
    padding: 8px 12px;
    background: transparent;
    z-index: 30;
  }

  /* ABSOLUTE FULLSCREEN TAKEOVER ON FOCUS/OPEN */
  body:has(.predictive-search-results.is-open) {
    overflow: hidden !important;
  }

  .predictive-search-wrapper:has(.predictive-search-results.is-open),
  .predictive-search-wrapper--drawer:has(.predictive-search-results.is-open) {
    position: fixed !important;
    top: 0 !important;
    left: 0 !important;
    right: 0 !important;
    bottom: 0 !important;
    width: 100vw !important;
    height: 100vh !important;
    z-index: 999999 !important;
    background: #ffffff !important;
    display: flex !important;
    flex-direction: column !important;
    padding: 0 !important;
  }

  /* TOP BAR: Back Button + Input Pill Container */
  .predictive-search-wrapper:has(.predictive-search-results.is-open) .pill-search {
    display: flex !important;
    align-items: center !important;
    gap: 8px !important;
    width: 100% !important;
    background: #ffffff !important;
    border: none !important;
    border-bottom: 1px solid #e5e5e5 !important;
    border-radius: 0 !important;
    padding: 10px 14px !important;
    box-shadow: none !important;
  }

  .predictive-search-wrapper:has(.predictive-search-results.is-open) .psr-back-btn {
    display: flex !important;
    color: #444;
  }

  .predictive-search-wrapper:has(.predictive-search-results.is-open) .pill-search__icon {
    display: none !important;
  }

  /* Pill input box container on mobile */
  .predictive-search-wrapper:has(.predictive-search-results.is-open) .pill-search__input {
    background: #f7f7f8 !important;
    border: 1px solid #dcdcdc !important;
    border-radius: 9999px !important;
    padding: 8px 36px 8px 16px !important;
    font-size: 14px !important;
    color: #333 !important;
    height: 38px !important;
  }

  /* Place X clear button inside the right edge of input box */
  .predictive-search-wrapper:has(.predictive-search-results.is-open) .psr-clear-btn {
    position: absolute !important;
    right: 24px !important;
    top: 50% !important;
    transform: translateY(-50%) !important;
    background: transparent !important;
    border: none !important;
    color: #888 !important;
    z-index: 2 !important;
    margin: 0 !important;
  }

  /* MAIN RESULTS SCROLL CONTAINER */
  .predictive-search-results {
    position: static !important;
    width: 100% !important;
    max-width: 100% !important;
    max-height: none !important;
    border-radius: 0 !important;
    box-shadow: none !important;
    border: none !important;
  }

  .predictive-search-results.is-open {
    display: flex !important;
    flex-direction: column !important;
    flex: 1 !important;
    overflow-y: auto !important;
    background: #ffffff !important;
  }

  /* LEFT & RIGHT CONTAINERS */
  .psr-left {
    display: block !important;
    background: #ffffff !important;
    border-right: none !important;
    padding: 0 !important;
  }

  .psr-right {
    padding: 0 16px 24px !important;
  }

  /* FULL-WIDTH GREY SECTION HEADERS */
  .psr-section h4,
  .psr-products-header {
    text-align: center !important;
    background: #f8f8f8 !important;
    margin: 0 !important;
    padding: 10px 16px !important;
    color: #666666 !important;
    font-size: 14px !important;
    font-weight: 500 !important;
    text-transform: none !important;
    letter-spacing: normal !important;
    border-top: 1px solid #eeeeee !important;
    border-bottom: 1px solid #eeeeee !important;
    display: block !important;
    width: 100% !important;
  }

  .psr-section {
    padding: 0 !important;
    border: none !important;
  }

  /* LIST ITEMS UNDER SUGGESTIONS & COLLECTIONS */
  .psr-section a {
    padding: 12px 16px !important;
    background: #ffffff !important;
    border-bottom: 1px solid #f0f0f0 !important;
    font-size: 14px !important;
    color: #333333 !important;
    display: block !important;
    text-decoration: none !important;
  }

  .psr-section a:last-child {
    border-bottom: none !important;
  }

  /* 2-COLUMN PRODUCT GRID */
  .psr-products-grid {
    display: grid !important;
    grid-template-columns: 1fr 1fr !important;
    gap: 20px 12px !important;
    margin-top: 12px !important;
  }

  /* VERTICAL PRODUCT CARD */
  .psr-product {
    display: flex !important;
    flex-direction: column !important;
    gap: 8px !important;
  }

  .psr-product img,
  .psr-product svg {
    width: 100% !important;
    height: auto !important;
    aspect-ratio: 1 / 1 !important;
    object-fit: cover !important;
    border-radius: 8px !important;
    background: #f4f4f4 !important;
  }

  .psr-product-title {
    font-size: 13px !important;
    line-height: 1.35 !important;
    color: #222222 !important;
    font-weight: 400 !important;
    margin-bottom: 2px !important;
  }

  .psr-product-price {
    font-size: 14px !important;
    font-weight: 700 !important;
    color: #000000 !important;
  }

  .predictive-search-wrapper.search-action--hidden-on-drawer {
    display: none !important;
  }
}

@media screen and (min-width: 750px) {
  [data-menu-style='drawer'] .predictive-search-wrapper.search-action--hidden-on-drawer {
    display: none;
  }

  [data-menu-style='menu'] .predictive-search-wrapper.search-action--hidden-on-menu {
    display: none;
  }
}
{% endstylesheet %}

{% javascript %}
class PredictiveSearch {
  constructor(wrapper) {
    this.wrapper = wrapper;
    this.input = wrapper.querySelector('.pill-search__input');
    this.results = wrapper.querySelector('.predictive-search-results');
    this.suggestionsEl = wrapper.querySelector('.psr-suggestions');
    this.collectionsEl = wrapper.querySelector('.psr-collections');
    this.pagesEl = wrapper.querySelector('.psr-pages');
    this.productsEl = wrapper.querySelector('.psr-products-grid');
    this.productsHeader = wrapper.querySelector('.psr-products-header');
    this.viewAll = wrapper.querySelector('.psr-view-all');
    this.backBtn = wrapper.querySelector('.psr-back-btn');
    this.clearBtn = wrapper.querySelector('.psr-clear-btn');

    if (!this.input || !this.results) return;

    this.debounceTimer = null;

    this.input.addEventListener('input', () => this.onInput());
    this.input.addEventListener('focus', () => this.onFocus());

    if (this.backBtn) {
      this.backBtn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        this.close();
      });
    }

    if (this.clearBtn) {
      this.clearBtn.addEventListener('click', () => {
        this.input.value = '';
        this.clearBtn.hidden = true;
        this.input.focus();
        this.showTrendingProducts();
      });
    }

    document.addEventListener('click', (e) => {
      if (!e.target.closest('.predictive-search-wrapper')) {
        this.close();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') this.close();
    });
  }

  onFocus() {
    const query = this.input.value.trim();
    if (this.clearBtn) this.clearBtn.hidden = query.length === 0;

    if (query.length === 0) {
      this.showTrendingProducts();
    } else {
      this.open();
    }
  }

  onInput() {
    clearTimeout(this.debounceTimer);
    const query = this.input.value.trim();

    if (this.clearBtn) this.clearBtn.hidden = query.length === 0;

    if (query.length < 1) {
      this.showTrendingProducts();
      return;
    }

    this.debounceTimer = setTimeout(() => this.fetchResults(query), 280);
  }

  // ========== TRENDING PRODUCTS ==========
  async showTrendingProducts() {
    this.results.classList.add('is-trending');
    this.productsHeader.textContent = 'Trending products';
    this.viewAll.href = '/collections/all';
    this.viewAll.textContent = 'View all products →';

    this.suggestionsEl.innerHTML = '';
    this.collectionsEl.innerHTML = '';
    this.pagesEl.innerHTML = '';

    this.productsEl.innerHTML = `<div class="psr-loading">Loading…</div>`;
    this.open();

    try {
      let res = await fetch('/collections/trending/products.json?limit=8');
      let data = await res.json();

      if (!data.products || data.products.length === 0) {
        res = await fetch('/collections/all/products.json?limit=8');
        data = await res.json();
      }
      this.renderTrending(data.products || []);
    } catch (err) {
      this.productsEl.innerHTML = `<div class="psr-empty">No trending products</div>`;
    }
  }

  renderTrending(products) {
    const placeholder = this.wrapper?.dataset.placeholder || '';

    if (!products.length) {
      this.productsEl.innerHTML = `<div class="psr-empty">No trending products</div>`;
      return;
    }

    this.productsEl.innerHTML = products.map(p => {
      const img = p.featured_image || (p.images && p.images[0] && p.images[0].src) || null;
      const rawPrice = p.variants && p.variants[0] ? p.variants[0].price : p.price;
      const price = this.formatMoney(rawPrice, true);

      return `
      <a href="/products/${p.handle}" class="psr-product">
        ${img
          ? `<img src="${img}" alt="${p.title}" loading="lazy" width="70" height="70">`
          : placeholder
        }
        <div class="psr-product-info">
          <div class="psr-product-title">${p.title}</div>
          <div class="psr-product-price">${price}</div>
        </div>
      </a>
      `;
    }).join('');
  }

  // ========== SEARCH RESULTS ==========
  async fetchResults(query) {
    this.results.classList.remove('is-trending');
    this.productsHeader.textContent = 'Products';
    this.productsEl.innerHTML = `<div class="psr-loading">Searching…</div>`;
    this.open();

    const root = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/';
    const url =
      `${root}search/suggest.json?q=${encodeURIComponent(query)}&resources[type]=product,collection,page,article,query&resources[limit]=8&resources[limit_scope]=each&resources[options][unavailable_products]=last`;

    try {
      const res = await fetch(url);
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const data = await res.json();
      this.render(data.resources?.results || {}, query);
    } catch (err) {
      this.productsEl.innerHTML = `<div class="psr-empty">Something went wrong</div>`;
    }
  }

  render(results, query) {
    // Suggestions
    if (results.queries && results.queries.length) {
      this.suggestionsEl.innerHTML = `
      <h4>Popular suggestions</h4>
      ${results.queries.map(q => `<a href="${q.url}">${q.styled_text || q.text}</a>`).join('')}
      `;
    } else {
      this.suggestionsEl.innerHTML = '';
    }

    // Collections
    if (results.collections && results.collections.length) {
      this.collectionsEl.innerHTML = `
      <h4>Collections</h4>
      ${results.collections.map(c => `<a href="${c.url}">${c.title}</a>`).join('')}
      `;
    } else {
      this.collectionsEl.innerHTML = '';
    }

    // Pages & Articles
    const pagesAndArticles = [...(results.pages || []), ...(results.articles || [])];
    if (pagesAndArticles.length) {
      this.pagesEl.innerHTML = `
      <h4>Blog & Pages</h4>
      ${pagesAndArticles.map(p => `<a href="${p.url}">${p.title}</a>`).join('')}
      `;
    } else {
      this.pagesEl.innerHTML = '';
    }

    // Products
    const placeholder = this.wrapper?.dataset.placeholder || '';

    if (results.products && results.products.length) {
      this.productsEl.innerHTML = results.products.map(p => {
        const img = p.featured_image?.url || p.image || null;
        const price = this.formatMoney(p.price);

        return `
        <a href="${p.url}" class="psr-product">
          ${img
            ? `<img src="${img}" alt="${p.title}" loading="lazy" width="70" height="70">`
            : placeholder
          }
          <div class="psr-product-info">
            <div class="psr-product-title">${p.title}</div>
            <div class="psr-product-price">${price}</div>
          </div>
        </a>
        `;
      }).join('');
    } else {
      this.productsEl.innerHTML = `<div class="psr-empty">No products found</div>`;
    }

    this.viewAll.href = `${(window.Shopify?.routes?.root || '/')}search?q=${encodeURIComponent(query)}`;
    this.viewAll.textContent = `View all results →`;
  }

  formatMoney(cents, isAlreadyFormatted = false) {
    if (typeof cents === 'undefined' || cents === null || cents === '') return '';

    const moneyFormat = this.wrapper?.dataset.moneyFormat || '${{amount}}';
    const currencySymbol = this.wrapper?.dataset.currency || '';

    if (isAlreadyFormatted) {
      const amount = parseFloat(cents).toFixed(2);
      return currencySymbol + amount;
    }

    if (typeof Shopify !== 'undefined' && typeof Shopify.formatMoney === 'function') {
      return Shopify.formatMoney(cents, moneyFormat);
    }

    return currencySymbol + (Number(cents) / 100).toFixed(2);
  }

  open() {
    this.results.classList.add('is-open');
    this.input.setAttribute('aria-expanded', 'true');

    if (window.matchMedia('(max-width: 749px)').matches) {
      document.body.style.overflow = 'hidden';
    }
  }

  close() {
    this.results.classList.remove('is-open', 'is-trending');
    this.input.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';

    // Unfocus active inputs to reset transparent header & pill states instantly
    this.input.blur();
    if (this.backBtn) this.backBtn.blur();

    const pill = this.wrapper.querySelector('.pill-search');
    if (pill) pill.blur();

    if (document.activeElement instanceof HTMLElement) {
      document.activeElement.blur();
    }
  }
}

document.querySelectorAll('.predictive-search-wrapper').forEach((wrapper) => {
  new PredictiveSearch(wrapper);
});
